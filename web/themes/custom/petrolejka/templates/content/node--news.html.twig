{#
/**
 * @file
 * Riadok v zozname správ (režim zobrazenia „news“): dátum a názov.
 */
#}
<article{{ attributes.addClass('news-item') }}>
  <time class="news-item__date" datetime="{{ date_iso }}">{{ date_human }}</time>
  <h3{{ title_attributes.addClass('news-item__title') }}><a href="{{ url }}">{{ label }}</a></h3>
</article>
