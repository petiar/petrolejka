{#
/**
 * @file
 * Všeobecné plné zobrazenie (stránky).
 */
#}
<article{{ attributes.addClass('story', 'story--' ~ node.bundle|clean_class) }}>
  <header class="story__header">
    <h1{{ title_attributes.addClass('story__title') }}>{{ label }}</h1>
  </header>

  {% if content.field_image|render|trim %}
    <figure class="story__figure">{{ content.field_image }}</figure>
  {% endif %}

  <div{{ content_attributes.addClass('story__body', 'prose') }}>
    {{ content|without('field_image', 'field_prilohy', 'links') }}
  </div>

  {% if content.field_prilohy|render|trim %}
    <section class="documents">
      <h2>{{ 'Dokumenty na stiahnutie'|t }}</h2>
      {{ content.field_prilohy }}
    </section>
  {% endif %}
</article>
